    "@capacitor/network": "8.0.1",
    "@capacitor/splash-screen": "8.0.2",
    "@capacitor/status-bar": "8.0.4",
    "socket.io-client": "4.8.4"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.4.3",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "rollup": "^4.65.0"
  },
