{
  "name": "tempchat-android",
  "version": "1.2.0",
  "private": true,
  "description": "Capacitor Android packaging for the TempChat frontend.",
  "scripts": {
    "build": "node scripts/build-android-web.js",
    "android:sync": "cap sync android",
    "android:debug": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-android-debug.ps1",
    "test": "npm run test:backend && npm run test:private-rooms && npm run test:accounts && npm run test:session-refresh && npm run test:social && npm run test:friend-chat && npm run test:room-session",
    "test:backend": "node backend/test/socket-smoke.js",
    "test:private-rooms": "node backend/test/private-rooms.js",
    "test:room-session": "node scripts/test-room-session.js",
    "check:frontend": "node scripts/check-frontend.js",
    "test:accounts": "node backend/test/account-security.js",
    "test:session-refresh": "node backend/test/session-refresh.js",
    "test:social": "node backend/test/social-sockets.js",
    "test:friend-chat": "node backend/test/friend-chat-flow.js"
  },
  "dependencies": {
    "@aparajita/capacitor-secure-storage": "^8.0.1",
    "@capacitor/android": "8.5.3",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.5.3",
    "@capacitor/network": "8.0.1",
    "@capacitor/splash-screen": "8.0.2",
    "@capacitor/status-bar": "8.0.4",
    "socket.io-client": "4.8.4"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.4.3",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "rollup": "^4.65.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
