# Copy to backend/.env for local development. Do not commit backend/.env.
PORT=3000
NODE_ENV=development
APP_ORIGIN=https://tempchat-app-backend.onrender.com
CORS_ORIGINS=https://tempchat-app-backend.onrender.com,capacitor://localhost,https://localhost,http://localhost:3000

# Supabase PostgreSQL connection string
# Format: postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:password@db.supabase.co:5432/postgres
# Set to false only if Supabase SSL is explicitly disabled (not recommended)
PG_SSL=true

# Generate a new value locally with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-with-a-new-random-secret-of-at-least-32-bytes

# Set to true to log redacted connection diagnostics
TEMPCHAT_PG_DEBUG=false

